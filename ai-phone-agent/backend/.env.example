# ============================================
# AI Phone Agent - Environment Variables
# Copy this file to .env and fill in your keys
# ============================================

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# --- Vobiz Telephony ---
VOBIZ_API_KEY=your_vobiz_api_key_here
VOBIZ_BASE_URL=https://api.vobiz.com/v1

# --- Sarvam AI (Voice) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# --- LLM Configuration ---
# Available: groq, openai, anthropic, deepseek
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=512

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=512

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=512

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=512

# --- Redis ---
# Leave empty to use in-memory fallback (good for local testing)
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# --- Business Context ---
BUSINESS_NAME="Acme Coaching"
BUSINESS_TYPE=coaching
AGENT_LANGUAGE=hi-IN
BATTLE_CARD_TEXT="""We are Acme Coaching, India's top IIT-JEE coaching institute.
Key offerings:
- 1-year intensive program for JEE Mains & Advanced
- 50+ faculty from IITs and NITs
- Small batch sizes (20 students max)
- 95% success rate in JEE Mains
- Online + offline hybrid model
- Fees: Rs 1,50,000 per year (EMI available)
- Free demo classes available
- Scholarship test on 15th of every month

Objection handling:
- Too expensive: Mention EMI options, scholarship tests, ROI of IIT degree
- Not sure about online: Free demo class, hybrid model explanation
- Already in another coaching: Differentiator pitch, free trial
- Need to think: Urgency creation (batch filling up), limited seats
- Need to talk to parents: Offer to speak with parents directly
"""
